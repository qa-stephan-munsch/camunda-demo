<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_DocumentRouting"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.40.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="document-routing" name="Document routing" isExecutable="true">
    <bpmn:startEvent id="StartEvent_DocumentReceived" name="Document received"
                     zeebe:modelerTemplate="io.camunda.connectors.inbound.KafkaMessageStart.v1"
                     zeebe:modelerTemplateVersion="8">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:connector-kafka-inbound:1" />
          <zeebe:property name="authenticationType" value="credentials" />
          <zeebe:property name="topic.bootstrapServers" value="localhost:9092" />
          <zeebe:property name="topic.topicName" value="documents-in" />
          <zeebe:property name="groupId" value="document-routing" />
          <zeebe:property name="autoOffsetReset" value="earliest" />
          <zeebe:property name="schemaStrategy.type" value="noSchema" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="correlationRequired" value="notRequired" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="resultExpression" value="={filename: value.filename, headline: value.headline, content: value.content}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToClassifyDocument</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_DocumentReceived" messageRef="Message_DocumentReceived" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToClassifyDocument" sourceRef="StartEvent_DocumentReceived" targetRef="ClassifyDocument" />
    <bpmn:serviceTask id="ClassifyDocument" name="Classify document">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="classify-document" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToClassifyDocument</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDetermineRoute</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToDetermineRoute" sourceRef="ClassifyDocument" targetRef="DetermineRoute" />
    <bpmn:businessRuleTask id="DetermineRoute" name="Determine route">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="routingDecision" resultVariable="routing" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDetermineRoute</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayRoute</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_ToGatewayRoute" sourceRef="DetermineRoute" targetRef="Gateway_Route" />
    <bpmn:exclusiveGateway id="Gateway_Route" name="Which route?" default="Flow_ToGeneralInbox">
      <bpmn:incoming>Flow_ToGatewayRoute</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAccounting</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToCustomerService</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToGeneralInbox</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToAccounting" name="accounting" sourceRef="Gateway_Route" targetRef="ForwardToAccounting">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=routing.route = "accounting"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToCustomerService" name="customer-service" sourceRef="Gateway_Route" targetRef="ForwardToCustomerService">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=routing.route = "customer-service"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToGeneralInbox" name="otherwise" sourceRef="Gateway_Route" targetRef="ForwardToGeneralInbox" />
    <bpmn:serviceTask id="ForwardToAccounting" name="Forward to accounting"
                      zeebe:modelerTemplate="io.camunda.connectors.KAFKA.v1"
                      zeebe:modelerTemplateVersion="7">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:connector-kafka:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="localhost:9092" target="topic.bootstrapServers" />
          <zeebe:input source="documents-out" target="topic.topicName" />
          <zeebe:input source="noSchema" target="schemaStrategy.type" />
          <zeebe:input source="=filename" target="message.key" />
          <zeebe:input source="={filename: filename, headline: headline, category: category, routedTo: routing.route, priority: routing.priority}" target="message.value" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.KAFKA.v1" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAccounting</bpmn:incoming>
      <bpmn:outgoing>Flow_FromAccounting</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ForwardToGeneralInbox" name="Forward to general inbox"
                      zeebe:modelerTemplate="io.camunda.connectors.KAFKA.v1"
                      zeebe:modelerTemplateVersion="7">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:connector-kafka:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="localhost:9092" target="topic.bootstrapServers" />
          <zeebe:input source="documents-out" target="topic.topicName" />
          <zeebe:input source="noSchema" target="schemaStrategy.type" />
          <zeebe:input source="=filename" target="message.key" />
          <zeebe:input source="={filename: filename, headline: headline, category: category, routedTo: routing.route, priority: routing.priority}" target="message.value" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.KAFKA.v1" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGeneralInbox</bpmn:incoming>
      <bpmn:outgoing>Flow_FromGeneralInbox</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ForwardToCustomerService" name="Forward to customer service"
                      zeebe:modelerTemplate="io.camunda.connectors.KAFKA.v1"
                      zeebe:modelerTemplateVersion="7">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:connector-kafka:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="localhost:9092" target="topic.bootstrapServers" />
          <zeebe:input source="documents-out" target="topic.topicName" />
          <zeebe:input source="noSchema" target="schemaStrategy.type" />
          <zeebe:input source="=filename" target="message.key" />
          <zeebe:input source="={filename: filename, headline: headline, category: category, routedTo: routing.route, priority: routing.priority}" target="message.value" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.KAFKA.v1" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCustomerService</bpmn:incoming>
      <bpmn:outgoing>Flow_FromCustomerService</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_FromAccounting" sourceRef="ForwardToAccounting" targetRef="Gateway_Routed" />
    <bpmn:sequenceFlow id="Flow_FromCustomerService" sourceRef="ForwardToCustomerService" targetRef="Gateway_Routed" />
    <bpmn:sequenceFlow id="Flow_FromGeneralInbox" sourceRef="ForwardToGeneralInbox" targetRef="Gateway_Routed" />
    <bpmn:exclusiveGateway id="Gateway_Routed">
      <bpmn:incoming>Flow_FromAccounting</bpmn:incoming>
      <bpmn:incoming>Flow_FromCustomerService</bpmn:incoming>
      <bpmn:incoming>Flow_FromGeneralInbox</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Gateway_Routed" targetRef="EndEvent_DocumentRouted" />
    <bpmn:endEvent id="EndEvent_DocumentRouted" name="Document routed">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_DocumentReceived" name="document-received" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_DocumentRouting">
    <bpmndi:BPMNPlane id="BPMNPlane_DocumentRouting" bpmnElement="document-routing">
      <bpmndi:BPMNShape id="StartEvent_DocumentReceived_di" bpmnElement="StartEvent_DocumentReceived">
        <dc:Bounds x="152" y="164" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="207" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClassifyDocument_di" bpmnElement="ClassifyDocument">
        <dc:Bounds x="240" y="142" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DetermineRoute_di" bpmnElement="DetermineRoute">
        <dc:Bounds x="390" y="142" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Route_di" bpmnElement="Gateway_Route" isMarkerVisible="true">
        <dc:Bounds x="545" y="157" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="482" y="203" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ForwardToAccounting_di" bpmnElement="ForwardToAccounting">
        <dc:Bounds x="650" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ForwardToCustomerService_di" bpmnElement="ForwardToCustomerService">
        <dc:Bounds x="650" y="142" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ForwardToGeneralInbox_di" bpmnElement="ForwardToGeneralInbox">
        <dc:Bounds x="650" y="244" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Routed_di" bpmnElement="Gateway_Routed" isMarkerVisible="true">
        <dc:Bounds x="805" y="157" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_DocumentRouted_di" bpmnElement="EndEvent_DocumentRouted">
        <dc:Bounds x="902" y="164" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="880" y="207" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToClassifyDocument_di" bpmnElement="Flow_ToClassifyDocument">
        <di:waypoint x="188" y="182" />
        <di:waypoint x="240" y="182" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDetermineRoute_di" bpmnElement="Flow_ToDetermineRoute">
        <di:waypoint x="340" y="182" />
        <di:waypoint x="390" y="182" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGatewayRoute_di" bpmnElement="Flow_ToGatewayRoute">
        <di:waypoint x="490" y="182" />
        <di:waypoint x="545" y="182" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAccounting_di" bpmnElement="Flow_ToAccounting">
        <di:waypoint x="570" y="157" />
        <di:waypoint x="570" y="80" />
        <di:waypoint x="650" y="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="62" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCustomerService_di" bpmnElement="Flow_ToCustomerService">
        <di:waypoint x="595" y="182" />
        <di:waypoint x="650" y="182" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="596" y="164" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGeneralInbox_di" bpmnElement="Flow_ToGeneralInbox">
        <di:waypoint x="570" y="207" />
        <di:waypoint x="570" y="284" />
        <di:waypoint x="650" y="284" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="290" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromAccounting_di" bpmnElement="Flow_FromAccounting">
        <di:waypoint x="750" y="80" />
        <di:waypoint x="830" y="80" />
        <di:waypoint x="830" y="157" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromCustomerService_di" bpmnElement="Flow_FromCustomerService">
        <di:waypoint x="750" y="182" />
        <di:waypoint x="805" y="182" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromGeneralInbox_di" bpmnElement="Flow_FromGeneralInbox">
        <di:waypoint x="750" y="284" />
        <di:waypoint x="830" y="284" />
        <di:waypoint x="830" y="207" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="855" y="182" />
        <di:waypoint x="902" y="182" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
