<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_DocumentIntake" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="document-intake" name="Document intake" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LetterScanned" name="Letter scanned">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;letter&quot;" target="channel" />
          <zeebe:output source="=sender" target="sender" />
          <zeebe:output source="=scannedText" target="scannedText" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_LetterToMerge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_LetterScanned" messageRef="Message_LetterScanned" />
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_EmailReceived" name="Email received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;email&quot;" target="channel" />
          <zeebe:output source="=sender" target="sender" />
          <zeebe:output source="=subject" target="subject" />
          <zeebe:output source="=body" target="body" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_EmailToMerge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_EmailReceived" messageRef="Message_EmailReceived" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeChannels">
      <bpmn:incoming>Flow_LetterToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_EmailToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStoreDocument</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="StoreDocument" name="Store document">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="store-document" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToStoreDocument</bpmn:incoming>
      <bpmn:outgoing>Flow_ToExtractText</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ExtractText" name="Extract text">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="extract-text" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToExtractText</bpmn:incoming>
      <bpmn:outgoing>Flow_ToClassifyDocument</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ClassifyDocument" name="Classify document">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="classify-document" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToClassifyDocument</bpmn:incoming>
      <bpmn:outgoing>Flow_ToConfident</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Confident" name="Classification confident?" default="Flow_NotConfident">
      <bpmn:incoming>Flow_ToConfident</bpmn:incoming>
      <bpmn:outgoing>Flow_Confident</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotConfident</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ClassifyManually" name="Classify document manually">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="classify-document-manually" />
        <zeebe:assignmentDefinition candidateGroups="intake-clerks" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotConfident</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_ClassificationReminder" name="4 hours" cancelActivity="false" attachedToRef="ClassifyManually">
      <bpmn:outgoing>Flow_ToNotifyTeamLead</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_ClassificationReminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT4H"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="NotifyTeamLead" name="Notify team lead">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-team-lead" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotifyTeamLead</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTeamLeadNotified</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_TeamLeadNotified" name="Team lead notified">
      <bpmn:incoming>Flow_ToTeamLeadNotified</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeClassified">
      <bpmn:incoming>Flow_Confident</bpmn:incoming>
      <bpmn:incoming>Flow_ManualToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDetermineRouting</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="DetermineRouting" name="Determine routing">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="routingDecision" resultVariable="routing" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDetermineRouting</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProcessDocument</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="ProcessDocument" name="Process document">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=routing.targetProcess" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:output source="=outcome" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProcessDocument</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessedToMerge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Error_ProcessingFailed" name="Processing failed" attachedToRef="ProcessDocument">
      <bpmn:outgoing>Flow_ToHandleFailedDocument</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_ProcessingFailed" errorRef="Error_DocumentProcessingFailed" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="HandleFailedDocument" name="Handle failed document">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="handle-failed-document" />
        <zeebe:assignmentDefinition candidateGroups="intake-clerks" />
        <zeebe:ioMapping>
          <zeebe:output source="=resolutionNotes" target="resolutionNotes" />
          <zeebe:output source="=if resolutionNotes = null then &quot;failed, resolved by clerk&quot; else &quot;failed, resolved by clerk: &quot; + resolutionNotes" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHandleFailedDocument</bpmn:incoming>
      <bpmn:outgoing>Flow_FailureHandledToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeResult">
      <bpmn:incoming>Flow_ProcessedToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_FailureHandledToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReportResult</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReportResult" name="Report result">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="report-result" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReportResult</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDocumentDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_DocumentDone" name="Document done">
      <bpmn:incoming>Flow_ToDocumentDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_LetterToMerge" sourceRef="StartEvent_LetterScanned" targetRef="Gateway_MergeChannels" />
    <bpmn:sequenceFlow id="Flow_EmailToMerge" sourceRef="StartEvent_EmailReceived" targetRef="Gateway_MergeChannels" />
    <bpmn:sequenceFlow id="Flow_ToStoreDocument" sourceRef="Gateway_MergeChannels" targetRef="StoreDocument" />
    <bpmn:sequenceFlow id="Flow_ToExtractText" sourceRef="StoreDocument" targetRef="ExtractText" />
    <bpmn:sequenceFlow id="Flow_ToClassifyDocument" sourceRef="ExtractText" targetRef="ClassifyDocument" />
    <bpmn:sequenceFlow id="Flow_ToConfident" sourceRef="ClassifyDocument" targetRef="Gateway_Confident" />
    <bpmn:sequenceFlow id="Flow_Confident" name="yes" sourceRef="Gateway_Confident" targetRef="Gateway_MergeClassified">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confidence != null and confidence &gt;= 0.85</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotConfident" name="no" sourceRef="Gateway_Confident" targetRef="ClassifyManually" />
    <bpmn:sequenceFlow id="Flow_ManualToMerge" sourceRef="ClassifyManually" targetRef="Gateway_MergeClassified" />
    <bpmn:sequenceFlow id="Flow_ToNotifyTeamLead" sourceRef="Timer_ClassificationReminder" targetRef="NotifyTeamLead" />
    <bpmn:sequenceFlow id="Flow_ToTeamLeadNotified" sourceRef="NotifyTeamLead" targetRef="EndEvent_TeamLeadNotified" />
    <bpmn:sequenceFlow id="Flow_ToDetermineRouting" sourceRef="Gateway_MergeClassified" targetRef="DetermineRouting" />
    <bpmn:sequenceFlow id="Flow_ToProcessDocument" sourceRef="DetermineRouting" targetRef="ProcessDocument" />
    <bpmn:sequenceFlow id="Flow_ProcessedToMerge" sourceRef="ProcessDocument" targetRef="Gateway_MergeResult" />
    <bpmn:sequenceFlow id="Flow_ToHandleFailedDocument" sourceRef="Error_ProcessingFailed" targetRef="HandleFailedDocument" />
    <bpmn:sequenceFlow id="Flow_FailureHandledToMerge" sourceRef="HandleFailedDocument" targetRef="Gateway_MergeResult" />
    <bpmn:sequenceFlow id="Flow_ToReportResult" sourceRef="Gateway_MergeResult" targetRef="ReportResult" />
    <bpmn:sequenceFlow id="Flow_ToDocumentDone" sourceRef="ReportResult" targetRef="EndEvent_DocumentDone" />
  </bpmn:process>
  <bpmn:message id="Message_LetterScanned" name="letter-scanned" />
  <bpmn:message id="Message_EmailReceived" name="email-received" />
  <bpmn:error id="Error_DocumentProcessingFailed" name="Document processing failed" errorCode="DOCUMENT_PROCESSING_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_DocumentIntake">
    <bpmndi:BPMNPlane id="BPMNPlane_DocumentIntake" bpmnElement="document-intake">
      <bpmndi:BPMNShape id="StartEvent_LetterScanned_di" bpmnElement="StartEvent_LetterScanned">
        <dc:Bounds x="152" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_EmailReceived_di" bpmnElement="StartEvent_EmailReceived">
        <dc:Bounds x="152" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeChannels_di" bpmnElement="Gateway_MergeChannels" isMarkerVisible="true">
        <dc:Bounds x="245" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StoreDocument_di" bpmnElement="StoreDocument">
        <dc:Bounds x="340" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExtractText_di" bpmnElement="ExtractText">
        <dc:Bounds x="490" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClassifyDocument_di" bpmnElement="ClassifyDocument">
        <dc:Bounds x="640" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Confident_di" bpmnElement="Gateway_Confident" isMarkerVisible="true">
        <dc:Bounds x="795" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClassifyManually_di" bpmnElement="ClassifyManually">
        <dc:Bounds x="900" y="330" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyTeamLead_di" bpmnElement="NotifyTeamLead">
        <dc:Bounds x="1000" y="460" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_TeamLeadNotified_di" bpmnElement="EndEvent_TeamLeadNotified">
        <dc:Bounds x="1152" y="482" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeClassified_di" bpmnElement="Gateway_MergeClassified" isMarkerVisible="true">
        <dc:Bounds x="1065" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DetermineRouting_di" bpmnElement="DetermineRouting">
        <dc:Bounds x="1170" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ProcessDocument_di" bpmnElement="ProcessDocument">
        <dc:Bounds x="1320" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandleFailedDocument_di" bpmnElement="HandleFailedDocument">
        <dc:Bounds x="1420" y="330" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeResult_di" bpmnElement="Gateway_MergeResult" isMarkerVisible="true">
        <dc:Bounds x="1565" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReportResult_di" bpmnElement="ReportResult">
        <dc:Bounds x="1660" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_DocumentDone_di" bpmnElement="EndEvent_DocumentDone">
        <dc:Bounds x="1812" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_ClassificationReminder_di" bpmnElement="Timer_ClassificationReminder">
        <dc:Bounds x="932" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Error_ProcessingFailed_di" bpmnElement="Error_ProcessingFailed">
        <dc:Bounds x="1352" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_LetterToMerge_di" bpmnElement="Flow_LetterToMerge">
        <di:waypoint x="188" y="160" />
        <di:waypoint x="270" y="160" />
        <di:waypoint x="270" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EmailToMerge_di" bpmnElement="Flow_EmailToMerge">
        <di:waypoint x="188" y="280" />
        <di:waypoint x="270" y="280" />
        <di:waypoint x="270" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToStoreDocument_di" bpmnElement="Flow_ToStoreDocument">
        <di:waypoint x="295" y="220" />
        <di:waypoint x="340" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToExtractText_di" bpmnElement="Flow_ToExtractText">
        <di:waypoint x="440" y="220" />
        <di:waypoint x="490" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToClassifyDocument_di" bpmnElement="Flow_ToClassifyDocument">
        <di:waypoint x="590" y="220" />
        <di:waypoint x="640" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToConfident_di" bpmnElement="Flow_ToConfident">
        <di:waypoint x="740" y="220" />
        <di:waypoint x="795" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Confident_di" bpmnElement="Flow_Confident">
        <di:waypoint x="845" y="220" />
        <di:waypoint x="1065" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotConfident_di" bpmnElement="Flow_NotConfident">
        <di:waypoint x="820" y="245" />
        <di:waypoint x="820" y="370" />
        <di:waypoint x="900" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManualToMerge_di" bpmnElement="Flow_ManualToMerge">
        <di:waypoint x="1000" y="370" />
        <di:waypoint x="1090" y="370" />
        <di:waypoint x="1090" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToNotifyTeamLead_di" bpmnElement="Flow_ToNotifyTeamLead">
        <di:waypoint x="950" y="428" />
        <di:waypoint x="950" y="500" />
        <di:waypoint x="1000" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToTeamLeadNotified_di" bpmnElement="Flow_ToTeamLeadNotified">
        <di:waypoint x="1100" y="500" />
        <di:waypoint x="1152" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDetermineRouting_di" bpmnElement="Flow_ToDetermineRouting">
        <di:waypoint x="1115" y="220" />
        <di:waypoint x="1170" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToProcessDocument_di" bpmnElement="Flow_ToProcessDocument">
        <di:waypoint x="1270" y="220" />
        <di:waypoint x="1320" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ProcessedToMerge_di" bpmnElement="Flow_ProcessedToMerge">
        <di:waypoint x="1420" y="220" />
        <di:waypoint x="1565" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToHandleFailedDocument_di" bpmnElement="Flow_ToHandleFailedDocument">
        <di:waypoint x="1370" y="278" />
        <di:waypoint x="1370" y="370" />
        <di:waypoint x="1420" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FailureHandledToMerge_di" bpmnElement="Flow_FailureHandledToMerge">
        <di:waypoint x="1520" y="370" />
        <di:waypoint x="1590" y="370" />
        <di:waypoint x="1590" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReportResult_di" bpmnElement="Flow_ToReportResult">
        <di:waypoint x="1615" y="220" />
        <di:waypoint x="1660" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDocumentDone_di" bpmnElement="Flow_ToDocumentDone">
        <di:waypoint x="1760" y="220" />
        <di:waypoint x="1812" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
