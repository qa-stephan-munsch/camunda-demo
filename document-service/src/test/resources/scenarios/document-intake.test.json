{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "testCases": [
    {
      "name": "complaint email — classified confidently, triage handled, result reported",
      "description": "An email the classifier recognises with high confidence is routed straight to triage and its result is reported without manual classification.",
      "instructions": [
        {
          "type": "PUBLISH_MESSAGE",
          "name": "email-received",
          "correlationKey": "mail-1",
          "variables": { "sender": "max@example.com", "subject": "Beschwerde", "body": "Ich bin mit Ihrem Service unzufrieden." }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "StoreDocument" },
          "variables": { "documentId": "doc-1" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractText" },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ClassifyDocument" },
          "variables": { "docType": "complaint", "confidence": 0.93 }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "DetermineRouting" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "TriageDocument" },
          "variables": { "triageOutcome": "handled" }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "manual-triage" },
          "elementSelectors": [{ "elementId": "EndEvent_TriageCompleted" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ReportResult" },
          "variables": {}
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "EndEvent_DocumentDone" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "complaint letter — classified manually after reminder, triage fails, failure handled and reported",
      "description": "A letter with an uncertain classification waits for a clerk, the team lead is reminded after four hours, and when triage cannot process it a clerk resolves the failure before the result is reported.",
      "instructions": [
        {
          "type": "PUBLISH_MESSAGE",
          "name": "letter-scanned",
          "correlationKey": "scan-1",
          "variables": { "sender": "Erika Musterfrau", "scannedText": "Hiermit reiche ich eine Beschwerde ein." }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "StoreDocument" },
          "variables": { "documentId": "doc-2" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractText" },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ClassifyDocument" },
          "variables": { "docType": "complaint", "confidence": 0.74 }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "ClassifyManually" }],
          "state": "IS_ACTIVE"
        },
        {
          "type": "INCREASE_TIME",
          "duration": "PT5H"
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "NotifyTeamLead" },
          "variables": {}
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "EndEvent_TeamLeadNotified" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "ClassifyManually" }],
          "state": "IS_ACTIVE"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "ClassifyManually" },
          "variables": { "docType": "complaint" }
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "TriageDocument" },
          "variables": { "triageOutcome": "unprocessable" }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "Error_ProcessingFailed" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "HandleFailedDocument" },
          "variables": { "resolutionNotes": "Resolved by hand" }
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "variables": { "outcome": "failed, resolved by clerk: Resolved by hand" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ReportResult" },
          "variables": {}
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "invoice email — handed to invoice processing, only its outcome comes back",
      "description": "An invoice is routed to invoice processing (owned by another service and mocked here); its outcome is taken over for the report, its other variables are not.",
      "instructions": [
        {
          "type": "MOCK_CHILD_PROCESS",
          "processDefinitionId": "process-invoice",
          "variables": { "outcome": "invoice 4711 over 250.00 EUR, no approval needed, payment pay-doc-3 scheduled", "paymentId": "pay-doc-3" }
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "email-received",
          "correlationKey": "mail-2",
          "variables": { "sender": "max@example.com", "subject": "Rechnung 4711", "body": "Anbei die Rechnung über 250,00 EUR." }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "StoreDocument" },
          "variables": { "documentId": "doc-3" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractText" },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ClassifyDocument" },
          "variables": { "docType": "invoice", "confidence": 0.93 }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "ProcessDocument" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "variables": { "outcome": "invoice 4711 over 250.00 EUR, no approval needed, payment pay-doc-3 scheduled" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ReportResult" },
          "variables": {}
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "state": "IS_COMPLETED"
        }
      ]
    }
  ]
}
