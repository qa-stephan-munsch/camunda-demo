{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "testCases": [
    {
      "name": "urgent invoice — forwarded to accounting with high priority",
      "description": "An urgent invoice gets route accounting and priority high from the routing decision, takes path B and is published to documents-out by the Kafka connector task of B.",
      "instructions": [
        {
          "type": "PUBLISH_MESSAGE",
          "name": "document-received",
          "variables": {
            "filename": "invoice-acme-reminder.txt",
            "headline": "DRINGEND: Rechnung 4711",
            "content": "Second reminder."
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ClassifyDocument"
          },
          "variables": {
            "category": "invoice",
            "urgent": true
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "document-routing"
          },
          "elementSelectors": [
            {
              "elementId": "DetermineRoute"
            }
          ],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "document-routing"
          },
          "elementSelector": {
            "elementId": "ForwardToAccounting"
          },
          "variables": {
            "topic": {
              "bootstrapServers": "localhost:9092",
              "topicName": "documents-out"
            },
            "message": {
              "key": "invoice-acme-reminder.txt",
              "value": {
                "filename": "invoice-acme-reminder.txt",
                "headline": "DRINGEND: Rechnung 4711",
                "category": "invoice",
                "routedTo": "accounting",
                "priority": "high"
              }
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "ForwardToAccounting"
          },
          "variables": {}
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "document-routing"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "document-routing"
          },
          "elementSelectors": [
            {
              "elementId": "ForwardToCustomerService"
            },
            {
              "elementId": "ForwardToGeneralInbox"
            }
          ],
          "state": "IS_NOT_ACTIVATED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "document-routing"
          },
          "variables": {
            "filename": "invoice-acme-reminder.txt",
            "category": "invoice",
            "routing": {
              "route": "accounting",
              "priority": "high"
            }
          }
        }
      ]
    },
