{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "testCases": [
    {
      "name": "small invoice — paid without approval",
      "description": "An invoice up to 1,000 EUR from a known supplier is scheduled for payment without anyone approving it.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": { "processDefinitionId": "process-invoice" },
          "variables": { "documentId": "doc-10" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractInvoiceData" },
          "variables": { "invoiceNumber": "100", "amount": 250.00, "currency": "EUR" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "FindSupplier" },
          "variables": { "supplierId": "S-1001", "supplierName": "Muster GmbH" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "SchedulePayment" },
          "variables": {}
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "process-invoice" },
          "elementSelectors": [{ "elementId": "EndEvent_PaymentScheduled" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": { "processDefinitionId": "process-invoice" },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "medium invoice — approved by accounting, then paid",
      "description": "An invoice between 1,000 and 10,000 EUR needs approval from accounting before it is scheduled for payment.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": { "processDefinitionId": "process-invoice" },
          "variables": { "documentId": "doc-11" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractInvoiceData" },
          "variables": { "invoiceNumber": "101", "amount": 5000.00, "currency": "EUR" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "FindSupplier" },
          "variables": { "supplierId": "S-1001", "supplierName": "Muster GmbH" }
        },
        {
          "type": "ASSERT_USER_TASK",
          "userTaskSelector": { "elementId": "ApproveInvoice" },
          "state": "IS_CREATED",
          "candidateGroups": ["accounting"]
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "ApproveInvoice" },
          "variables": { "approvalDecision": "approve" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "SchedulePayment" },
          "variables": {}
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": { "processDefinitionId": "process-invoice" },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "large invoice — rejected by management",
      "description": "An invoice above 10,000 EUR goes to management; when they reject it, the supplier is informed and nothing is paid.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": { "processDefinitionId": "process-invoice" },
          "variables": { "documentId": "doc-12" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractInvoiceData" },
          "variables": { "invoiceNumber": "102", "amount": 25000.00, "currency": "EUR" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "FindSupplier" },
          "variables": { "supplierId": "S-1001", "supplierName": "Muster GmbH" }
        },
        {
          "type": "ASSERT_USER_TASK",
          "userTaskSelector": { "elementId": "ApproveInvoice" },
          "state": "IS_CREATED",
          "candidateGroups": ["management"]
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "ApproveInvoice" },
          "variables": { "approvalDecision": "reject", "approvalComment": "Not ordered" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "SendRejection" },
          "variables": {}
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "process-invoice" },
          "elementSelectors": [{ "elementId": "EndEvent_InvoiceRejected" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": { "processDefinitionId": "process-invoice" },
          "state": "IS_COMPLETED"
        }
      ]
    }
  ]
}
