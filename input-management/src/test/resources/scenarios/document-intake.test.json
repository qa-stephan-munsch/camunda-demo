{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "testCases": [
    {
      "name": "complaint email — classified confidently, triage handled",
      "description": "An email the classifier recognises with high confidence is routed straight to triage and processed without manual classification.",
      "instructions": [
        {
          "type": "PUBLISH_MESSAGE",
          "name": "email-received",
          "correlationKey": "mail-1",
          "variables": { "sender": "max@example.com", "subject": "Beschwerde", "body": "Ich bin mit Ihrem Service unzufrieden." }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "StoreDocument" },
          "variables": { "documentId": "doc-1" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractText" },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ClassifyDocument" },
          "variables": { "docType": "complaint", "confidence": 0.93 }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "DetermineRouting" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "TriageDocument" },
          "variables": { "triageOutcome": "handled" }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "manual-triage" },
          "elementSelectors": [{ "elementId": "EndEvent_TriageCompleted" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "EndEvent_DocumentProcessed" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "complaint letter — classified manually after reminder, triage fails, failure handled",
      "description": "A letter with an uncertain classification waits for a clerk, the team lead is reminded after four hours, and when triage cannot process it a clerk resolves the failure.",
      "instructions": [
        {
          "type": "PUBLISH_MESSAGE",
          "name": "letter-scanned",
          "correlationKey": "scan-1",
          "variables": { "sender": "Erika Musterfrau", "scannedText": "Hiermit reiche ich eine Beschwerde ein." }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "StoreDocument" },
          "variables": { "documentId": "doc-2" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractText" },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ClassifyDocument" },
          "variables": { "docType": "complaint", "confidence": 0.74 }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "ClassifyManually" }],
          "state": "IS_ACTIVE"
        },
        {
          "type": "INCREASE_TIME",
          "duration": "PT5H"
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "NotifyTeamLead" },
          "variables": {}
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "EndEvent_TeamLeadNotified" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "ClassifyManually" }],
          "state": "IS_ACTIVE"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "ClassifyManually" },
          "variables": { "docType": "complaint" }
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "TriageDocument" },
          "variables": { "triageOutcome": "unprocessable" }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "Error_ProcessingFailed" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "HandleFailedDocument" },
          "variables": { "resolutionNotes": "Resolved by hand" }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "EndEvent_FailureHandled" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "invoice email from unknown supplier — invoice processing fails, failure handled",
      "description": "An invoice is routed to invoice processing; its supplier is unknown, so invoice processing reports the document as failed and a clerk resolves it.",
      "instructions": [
        {
          "type": "PUBLISH_MESSAGE",
          "name": "email-received",
          "correlationKey": "mail-2",
          "variables": { "sender": "billing@unknown.org", "subject": "Rechnung 4711", "body": "Anbei die Rechnung über 1.250,00 EUR." }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "StoreDocument" },
          "variables": { "documentId": "doc-3" }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractText" },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ClassifyDocument" },
          "variables": { "docType": "invoice", "confidence": 0.93 }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": { "elementId": "ExtractInvoiceData" },
          "variables": { "invoiceNumber": "4711", "amount": 1250.00, "currency": "EUR" }
        },
        {
          "type": "THROW_BPMN_ERROR_FROM_JOB",
          "jobSelector": { "elementId": "FindSupplier" },
          "errorCode": "INVOICE_INVALID",
          "errorMessage": "Unknown supplier"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "process-invoice" },
          "elementSelectors": [{ "elementId": "Error_InvoiceInvalid" }],
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": { "elementId": "HandleFailedDocument" },
          "variables": { "resolutionNotes": "Supplier created, invoice entered by hand" }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": { "processDefinitionId": "document-intake" },
          "elementSelectors": [{ "elementId": "EndEvent_FailureHandled" }],
          "state": "IS_COMPLETED"
        }
      ]
    }
  ]
}
